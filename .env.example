# PostgreSQL
POSTGRES_USER=ckan
POSTGRES_PASSWORD=ckan
POSTGRES_DB=ckan

# CKAN
CKAN_SQLALCHEMY_URL=postgresql://ckan:ckan@db/ckan
CKAN_SITE_URL=http://localhost:5000
CKAN_SOLR_URL=http://solr:8983/solr/ckan
CKAN_REDIS_URL=redis://redis:6379/1
CKAN_SYSADMIN_NAME=admin
CKAN_SYSADMIN_PASSWORD=admin1234
CKAN_SYSADMIN_EMAIL=admin@localhost
# Space-separated list of CKAN plugins to enable.
# Add updateschema, extendedapi, extendedtheme as needed once the DB is seeded
# with the data those plugins expect.
CKAN_DATASTORE_WRITE_URL=postgresql://ckan:ckan@db/datastore
CKAN_DATASTORE_READ_URL=postgresql://datastore_ro:datastore@db/datastore
CKAN_PLUGINS=stats text_view image_view datatables_view datastore updateschema extendedapi extendedtheme
