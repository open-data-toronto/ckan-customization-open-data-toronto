# Unified dependency source for all CKAN extensions deployed together.
# Edit this file to add/change/remove dependencies, then regenerate requirements.txt:
#
#   bin/compile-requirements.sh
#
# requirements.txt is the generated lockfile consumed by:
#   - CloudFormation install_ckanext (pip install -r requirements.txt)
#   - Docker build (COPY + pip install -r)

# CKAN core deps
-r ../od-ckan/requirements.in

# ckanext-iotrans deps
-r ../od-ckanext-iotrans/requirements.txt

# ckanext-scheming (no requirements file; no extra deps beyond CKAN core)

# opendata_ckan direct deps
