# Unified dependency source for all CKAN extensions deployed together.
# Edit requirements.txt to add/change/remove opendata_ckan's own deps.
# Edit this file only to add/change dependencies from other repos or production pins.
# Then regenerate the lockfile:
#
#   bin/compile-requirements.sh
#
# requirements-lock.txt is the generated lockfile consumed by:
#   - CloudFormation install_ckanext (pip install -r requirements-lock.txt)
#   - Docker build (COPY + pip install -r)

# CKAN core deps
-r ../od-ckan/requirements.in

# ckanext-iotrans deps
-r ../od-ckanext-iotrans/requirements.txt

# ckanext-solr-sqs deps (boto3 already pinned below; included for completeness)
-r ../ckanext-solr-sqs/requirements.txt

# ckanext-scheming (no requirements file; no extra deps beyond CKAN core)

# opendata_ckan direct deps
-r requirements.txt

# Production version pins (security/stability overrides — keep in sync with CloudFormation)
botocore==1.40.39
boto3==1.40.39
urllib3==1.26.17
setuptools==78.1.1
# MarkupSafe 3.x changed Markup.replace() behaviour so dominate's util.escape()
# actually mutates Markup objects, causing HTML inside link labels (e.g. FA icons)
# to be double-escaped and rendered as visible entities.  2.1.x silently treated
# the replacements as no-ops because it escaped the search pattern itself first.
# Unblock when the od-ckan link_to() helper is fixed to use dominate.util.raw().
MarkupSafe==2.1.5
